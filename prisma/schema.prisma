generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(VIEWER)
  bio           String?   @db.Text
  profileImage  String?
  socialLinks   Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  posts    Post[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  ADMIN
  CREATOR
  VIEWER
}

model Post {
  id             String     @id @default(cuid())
  title          String
  subtitle       String?
  slug           String     @unique
  content        String     @db.Text
  excerpt        String?    @db.Text
  coverImage     String?
  images         String[]
  status         PostStatus @default(DRAFT)
  featured       Boolean    @default(false)
  sponsored      Boolean    @default(false)
  sponsoredLabel String?
  scheduledAt    DateTime?
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  seoTitle        String?
  metaDescription String?
  keywords        String[]
  canonicalUrl    String?
  ogImage         String?

  readingTime Int @default(0)
  viewCount   Int @default(0)
  reactLike   Int @default(0)
  reactFire   Int @default(0)
  reactBulb   Int @default(0)

  faqItems    Json?
  seriesId    String?
  seriesOrder Int?

  authorId   String
  author     User          @relation(fields: [authorId], references: [id])
  categoryId String?
  category   Category?     @relation(fields: [categoryId], references: [id])
  series     Series?       @relation(fields: [seriesId], references: [id])
  tags       Tag[]
  affiliateLinks AffiliateLink[]
  analytics      PostAnalytic[]
  comments       Comment[]

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@index([featured])
  @@index([seriesId])
}

enum PostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  UNPUBLISHED
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  color       String?
  icon        String?
  createdAt   DateTime @default(now())

  posts Post[]
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  posts Post[]

  @@index([slug])
}

model AffiliateLink {
  id         String   @id @default(cuid())
  postId     String
  label      String
  url        String
  platform   String?
  clickCount Int      @default(0)
  createdAt  DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model SearchQuery {
  id        String   @id @default(cuid())
  query     String
  count     Int      @default(1)
  results   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([query])
  @@index([count])
}

model PostAnalytic {
  id     String   @id @default(cuid())
  postId String
  date   DateTime @default(now()) @db.Date
  views  Int      @default(0)
  source String?
  country String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, date, source])
  @@index([postId])
  @@index([date])
}

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Subscriber {
  id          String           @id @default(cuid())
  email       String           @unique
  name        String?
  status      SubscriberStatus @default(PENDING)
  token       String?          @unique
  confirmedAt DateTime?
  createdAt   DateTime         @default(now())

  @@index([status])
}

enum SubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

model Comment {
  id          String        @id @default(cuid())
  postId      String
  post        Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorName  String
  authorEmail String
  content     String        @db.Text
  status      CommentStatus @default(PENDING)
  createdAt   DateTime      @default(now())

  @@index([postId])
  @@index([status])
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Series {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  posts       Post[]

  @@index([slug])
}
